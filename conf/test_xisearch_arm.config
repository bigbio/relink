/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    ARM Mac local test — runs Python steps natively, Java steps in relink:1.0.0
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Use as follows:
        nextflow run main.nf -profile test_xisearch,docker,arm,test_xisearch_arm
----------------------------------------------------------------------------------------
*/

// Run Python-only modules natively (relink:1.1.0 segfaults under QEMU on ARM)
process {
    withName: 'SDRF_PARSING' {
        container = null
    }
    withName: 'MZIDENTML_EXPORT' {
        container = null
    }
    withName: 'MASS_RECALIBRATION' {
        container = null
    }
}
