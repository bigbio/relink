/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running Scout search engine tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines test dataset (PXD042173, 2 files) and Scout-specific parameters.
    Use as follows:
        nextflow run bigbio/relink -profile test_scout,docker
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Scout test profile'
    config_profile_description = 'Test Scout search engine with PXD042173 (2 files, DSSO crosslinked)'

    // Input — SDRF from quantms-test-datasets
    input          = 'https://raw.githubusercontent.com/bigbio/quantms-test-datasets/quantms/testdata/relink_ci/PXD042173_2files.sdrf.tsv'
    search_engine  = 'scout'

    // Database — hosted on PRIDE FTP
    fasta          = 'https://ftp.pride.ebi.ac.uk/pride/data/archive/2024/08/PXD042173/all_320_proteins_from_first_second_third_fourth_fifth_batch.fasta'

    // FDR
    link_fdr       = 5
    do_fdr         = true

    // Resource limits for CI
    max_cpus       = 2
    max_memory     = '6.GB'
    max_time       = '6.h'
}
