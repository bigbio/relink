/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running Scout search engine tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines test dataset (PXD042173, 2 files) and Scout-specific parameters.
    Use as follows:
        nextflow run bigbio/relink -profile test_scout,docker
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Scout test profile'
    config_profile_description = 'Test Scout search engine with PXD042173 (2 files, DSSO crosslinked)'

    // Input
    input          = "${projectDir}/assets/test_sdrf_PXD042173_2files.tsv"
    search_engine  = 'scout'
    outdir         = "${params.outdir ?: 'results'}"

    // Database
    fasta          = 'https://raw.githubusercontent.com/bigbio/relink/dev/assets/test_data/Homo_sapiens_320prots.fasta'

    // FDR
    link_fdr       = 5
    do_fdr         = true

    // Resource limits for testing
    max_cpus       = 2
    max_memory     = '6.GB'
    max_time       = '6.h'
}
