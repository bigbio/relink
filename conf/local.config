/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Local execution config — runs tools natively (no Docker)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Requires: Java 21, .NET 9+ (with DOTNET_ROLL_FORWARD=LatestMajor),
              Python 3.11+ with pyopenms, polars, sdrf-pipelines, xi-mzidentml-converter
----------------------------------------------------------------------------------------
*/

docker.enabled      = false
singularity.enabled = false

env {
    DOTNET_ROLL_FORWARD = 'LatestMajor'
}

process {
    container = null

    withName: 'XISEARCH_LINEAR|XISEARCH_CROSSLINK' {
        ext.xisearch_jar = "${HOME}/.local/opt/xisearch/xiSEARCH.jar"
    }

    withName: 'XIFDR' {
        ext.xifdr_jar = "${HOME}/.local/opt/xisearch/xiFDR.jar"
    }

    withName: 'SCOUT_SEARCH|SCOUT_FILTER|SCOUT_MZIDENTML' {
        ext.scout_cmd = "${HOME}/.local/opt/scout/run_scout.sh"
    }
}
